{
  "name": "astrolabe-ts",
  "version": "0.1.0",
  "private": true,
  "description": "Astrolabe Canonical Format (ACF) TypeScript SDK",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
